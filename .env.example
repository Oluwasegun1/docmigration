# Copy to .env.local and fill in values from your Supabase project
# (Project Settings -> API). Never commit .env.local.

# Public (bundled into the browser). Safe to expose; protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Public site URL, used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only for admin/background jobs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Environment label: development | staging | production
APP_ENV=development
